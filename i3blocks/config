# i3blocks configuration file
#
# The i3blocks man page describes the usage of the binary,
# and its website describes the configuration:
#
#     https://vivien.github.io/i3blocks


# Global properties
[hostname]
label= 
command=hostname
interval=3600
color=#bb9af7

[uptime]
label= 
command=uptime -p | cut -d " " -f2-
interval=60
color=#7dcfff

[cpu]
label= 
command=top -bn1 | grep "Cpu(s)" | awk '{print $2 + $4 "%"}'
interval=5
color=#9ece6a

[mem]
label= 
command=free -h | awk '/^Mem/ { print $3 "/" $2 }'
interval=5
color=#c0caf5

[volume]
label= 
command=amixer get Master | awk -F'[][]' '/%/ { print $2 }' | head -n1
interval=1
signal=10
color=#e0af68

[battery]
label= 
command=acpi -b | sed 's/Battery 0: //'
interval=30
color=#9ece6a

[net]
label=  
command=nmcli -t -f active,ssid dev wifi | grep '^yes' | cut -d: -f2
interval=10
color=#7aa2f7

[bluetooth]
label= 
command=~/.config/i3blocks/scripts/bluetooth_connected.sh
interval=10
color=#bb9af7

[time]
label= 
command=date '+%a %d %b %H:%M '
interval=30
color=#f7768e
