[global]
font = JetBrainsMono Nerd Font 10
frame_color = "#7c3e54"
separator_color = auto
background = "#140c18"
foreground = "#dcc7e4"

[urgency_low]
timeout = 5
background = "#140c18"
foreground = "#dcc7e4"
frame_color = "#36172d"

[urgency_normal]
timeout = 7
background = "#140c18"
foreground = "#dcc7e4"
frame_color = "#7c3e54"

[urgency_critical]
timeout = 0
background = "#582838"
foreground = "#ffffff"
frame_color = "#ff0000"
